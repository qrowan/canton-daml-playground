nodes.local.start()

val public = bootstrap.synchronizer(
  synchronizerName = "public",
  sequencers = Seq(publicSequencer),
  mediators = Seq(publicMediator),
  synchronizerOwners = Seq(publicSequencer),
  synchronizerThreshold = PositiveInt.one,
  staticSynchronizerParameters = StaticSynchronizerParameters.defaults(publicSequencer.config.crypto, ProtocolVersion.latest),
)

val consortium = bootstrap.synchronizer(
  synchronizerName = "consortium",
  sequencers = Seq(consortiumSequencer),
  mediators = Seq(consortiumMediator),
  synchronizerOwners = Seq(consortiumSequencer),
  synchronizerThreshold = PositiveInt.one,
  staticSynchronizerParameters = StaticSynchronizerParameters.defaults(consortiumSequencer.config.crypto, ProtocolVersion.latest),
)

bank.synchronizers.connect_local(publicSequencer, alias = "public")
bank.synchronizers.connect_local(consortiumSequencer, alias = "consortium")
issuer.synchronizers.connect_local(publicSequencer, alias = "public")
issuer.synchronizers.connect_local(consortiumSequencer, alias = "consortium")

// unassign 과 assign 사이의 구간을 눈으로 볼 수 있게 늘립니다. 기본값은 15초이고,
// 이 시간이 지나면 Canton 이 자동으로 assign 합니다.
val exclusivity = com.digitalasset.canton.config.NonNegativeFiniteDuration.ofMinutes(10)
publicSequencer.topology.synchronizer_parameters.propose_update(
  public.logical,
  _.update(assignmentExclusivityTimeout = exclusivity),
)
consortiumSequencer.topology.synchronizer_parameters.propose_update(
  consortium.logical,
  _.update(assignmentExclusivityTimeout = exclusivity),
)

import com.digitalasset.canton.topology.transaction.SynchronizerTrustCertificate.ParticipantTopologyFeatureFlag

Seq(bank, issuer).foreach { p =>
  Seq(public.logical, consortium.logical).foreach { s =>
    p.topology.synchronizer_trust_certificates.propose(
      participantId = p.id,
      synchronizerId = s,
      featureFlags = Seq(ParticipantTopologyFeatureFlag.EnableMultiSynchronizer),
    )
  }
}

val dar = sys.env.getOrElse("STEP08_DAR", "")
if (dar.nonEmpty) {
  Seq(bank, issuer).foreach { p =>
    Seq(public.logical, consortium.logical).foreach { s =>
      p.dars.upload(dar, synchronizerId = Some(s))
    }
  }
}

val publicAlias = SynchronizerAlias.tryCreate("public")
val consortiumAlias = SynchronizerAlias.tryCreate("consortium")

val bankParty = bank.parties.enable("Bank", synchronizer = Some(publicAlias))
val aliceParty = bank.parties.enable("Alice", synchronizer = Some(publicAlias))
val issuerParty = issuer.parties.enable("Issuer", synchronizer = Some(publicAlias))

bank.parties.enable("Bank", synchronizer = Some(consortiumAlias))
bank.parties.enable("Alice", synchronizer = Some(consortiumAlias))
issuer.parties.enable("Issuer", synchronizer = Some(consortiumAlias))

println("=== READY ===")
println("PUBLIC=" + public.logical.toProtoPrimitive)
println("CONSORTIUM=" + consortium.logical.toProtoPrimitive)
println("EXCLUSIVITY=" + exclusivity.toString)
println("BANK=" + bankParty.toProtoPrimitive)
println("ALICE=" + aliceParty.toProtoPrimitive)
println("ISSUER=" + issuerParty.toProtoPrimitive)
