nodes.local.start()

bootstrap.synchronizer(
  synchronizerName = "public",
  sequencers = Seq(publicSequencer),
  mediators = Seq(publicMediator),
  synchronizerOwners = Seq(publicSequencer),
  synchronizerThreshold = PositiveInt.one,
  staticSynchronizerParameters = StaticSynchronizerParameters.defaults(publicSequencer.config.crypto, ProtocolVersion.latest),
)

bank.synchronizers.connect_local(publicSequencer, alias = "public")
broker.synchronizers.connect_local(publicSequencer, alias = "public")

val dar = sys.env.getOrElse("STEP05_DAR", "")
if (dar.nonEmpty) {
  bank.dars.upload(dar)
  broker.dars.upload(dar)
}

val bankParty  = bank.parties.enable("Bank")
val aliceParty = bank.parties.enable("Alice")
val bobParty   = broker.parties.enable("Bob")

println("=== READY ===")
println("BANK="  + bankParty.toProtoPrimitive)
println("ALICE=" + aliceParty.toProtoPrimitive)
println("BOB="   + bobParty.toProtoPrimitive)
